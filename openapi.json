  "info": {
    "title": "Gym Split Planner",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog": {
      "get": {
        "description": "Muscoli, famiglie, etichette, esercizi e il resto del catalogo in una risposta.\n\nL'``ETag`` è calcolato sul contenuto: con ``If-None-Match`` uguale la risposta è\n``304`` senza corpo. ``Cache-Control: no-cache`` fa sì che il browser chieda\nsempre conferma al server, così una modifica al catalogo si vede subito.",
        "operationId": "read_catalog",
        "parameters": [
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Catalogo invariato rispetto all'ETag inviato"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tutto il catalogo",
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/exercises": {
      "post": {
        "description": "Crea l'esercizio e restituisce il dettaglio, con ``Location``.",
        "operationId": "post_exercise",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Dati non validi (`validation-error`) o regola violata (`rule-violation`)"
          }
        },
        "summary": "Crea un esercizio",
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/exercises/{exercise_id}": {
      "delete": {
        "description": "Se l'esercizio è in una scheda: ``409 in-use`` con ``usage``; va disattivato.",
        "operationId": "remove_exercise",
        "parameters": [
          {
            "in": "path",
            "name": "exercise_id",
            "required": true,
            "schema": {
              "title": "Exercise Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Esercizio inesistente"
          },
          "409": {
            "description": "Usato in una scheda (`in-use`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Elimina un esercizio mai usato",
        "tags": [
          "catalogo"
        ]
      },
      "get": {
        "description": "Tutti i campi, muscoli con note, etichette con note, fonti e varianti.",
        "operationId": "read_exercise",
        "parameters": [
          {
            "in": "path",
            "name": "exercise_id",
            "required": true,
            "schema": {
              "title": "Exercise Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Esercizio inesistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dettaglio di un esercizio",
        "tags": [
          "catalogo"
        ]
      },
      "put": {
        "description": "Tutti i campi, compresi muscoli, etichette, fonti e ``is_active`` (disattivazione).",
        "operationId": "put_exercise",
        "parameters": [
          {
            "in": "path",
            "name": "exercise_id",
            "required": true,
            "schema": {
              "title": "Exercise Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Esercizio inesistente"
          },
          "422": {
            "description": "Dati non validi (`validation-error`) o regola violata (`rule-violation`)"
          }
        },
        "summary": "Sostituisce un esercizio",
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/exercises/{exercise_id}/usage": {
      "get": {
        "description": "Schede che lo usano, per scrivere la conferma di eliminazione.",
        "operationId": "read_exercise_usage",
        "parameters": [
          {
            "in": "path",
            "name": "exercise_id",
            "required": true,
            "schema": {
              "title": "Exercise Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseUsageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Esercizio inesistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dove è usato un esercizio",
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Usato dal controllo di salute del container: risponde 503 se il database non risponde.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Database non raggiungibile"
          }
        },
        "summary": "Stato dell'applicazione",
        "tags": [
          "sistema"
        ]
      }
    },
    "/api/pdf/test": {
      "get": {
        "description": "Genera un PDF A4 di prova con tabella, simbolo SVG e numerazione delle pagine.",
        "operationId": "get_test_pdf",
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "PDF A4"
          }
        },
        "summary": "PDF di prova",
        "tags": [
          "sistema"
        ]
      }
    },
    "/api/sources": {
      "post": {
        "description": "Il codice è il successivo della serie ``src-NN``.",
        "operationId": "post_source",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Crea una fonte",
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/sources/{source_id}": {
      "delete": {
        "description": "Toglie anche i collegamenti agli esercizi che la citano.",
        "operationId": "remove_source",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Fonte inesistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Elimina una fonte",
        "tags": [
          "catalogo"
        ]
      },
      "patch": {
        "description": "Cambiano solo i campi inviati; ``null`` svuota i campi facoltativi.",
        "operationId": "patch_source",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourcePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Fonte inesistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Modifica una fonte",
        "tags": [
          "catalogo"
        ]
      }
    }
  }
}
